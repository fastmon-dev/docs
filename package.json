{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run generate:api && next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "node ./node_modules/fumadocs-mdx/bin.js && next typegen && tsc --noEmit",
    "postinstall": "node ./node_modules/fumadocs-mdx/bin.js",
    "generate:api": "node scripts/generate-api-docs.mjs",
    "draft:changelog": "node scripts/draft-changelog.mjs",
    "lint": "eslint",
    "lint:prose": "node scripts/check-prose.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,ts}\""
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.11.2",
    "fumadocs-mdx": "15.1.0",
    "fumadocs-openapi": "^11.1.1",
    "fumadocs-ui": "16.11.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.15",
    "prettier": "^3.9.5",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.0"
  }
}
