{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run generate:api && next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "node ./node_modules/fumadocs-mdx/bin.js && next typegen && tsc --noEmit",
    "postinstall": "node ./node_modules/fumadocs-mdx/bin.js",
    "generate:api": "node scripts/generate-api-docs.mjs",
    "draft:changelog": "node scripts/draft-changelog.mjs",
    "lint": "eslint",
    "lint:prose": "node scripts/check-prose.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,ts}\""
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-openapi": "^11.3.5",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "^1.30.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.5.0",
    "zbsearch": "^3.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.18",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.28.1",
    "minimatch": "^10.0.3",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
