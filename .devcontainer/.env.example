# Copy to .devcontainer/.env (git-ignored) and fill in. Compose reads it at
# container start, so rebuild after a change.

# Fine-grained PAT on the fastmon-dev repos you work on, with Contents, Pull
# requests and Issues read/write. Authenticates gh and git.
GH_TOKEN=

# Your commit email. user.name comes from the mounted host ~/.gitconfig.
GIT_EMAIL=
